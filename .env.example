# Never commit real values — copy this file to .env for local testing
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key

# Optional overrides (defaults to a real Android device in BrowserStack Automate)
BS_DEVICE_NAME=Google Pixel 8
BS_OS_VERSION=14.0
TARGET_URL=https://example.com
